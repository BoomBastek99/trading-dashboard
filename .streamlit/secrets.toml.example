# Copy this file to `.streamlit/secrets.toml` and fill in your keys.
# DO NOT commit secrets.toml — it should be in .gitignore.
#
# On Streamlit Community Cloud, paste these key/value pairs into the app's
# Settings → Secrets panel instead (no file needed).

# ── Market data (used by data_provider.py) ─────────────────────────────────
# FMP is the primary provider. Get a key at https://site.financialmodelingprep.com/
FMP_API_KEY = ""

# TwelveData is the fallback. Free tier: 8 req/min, 800/day.
# Get a key at https://twelvedata.com/
TWELVEDATA_API_KEY = ""

# ── News (sentiment_analysis_dashboard) ────────────────────────────────────
# Optional. Sentiment dashboard works fine without — it falls back to
# Google News RSS. Get a key at https://newsapi.org/
NEWSAPI_KEY = ""

# ── Macro (future / FRED-enhanced regime features) ─────────────────────────
# Get a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = ""
